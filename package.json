{
  "devDependencies": {
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "esbuild-copy-static-files": "^0.1.0",
    "typescript": "^7.0.2",
    "zip-a-folder": "^7.0.0"
  },
  "scripts": {
    "clean": "npx rimraf ./build",
    "compile": "npm run clean && npx tsc",
    "bundle": "npm run compile && node esbuild.mjs",
    "bundle:debug": "cross-env DEBUG=true npm run bundle",
    "build": "npm run bundle && node dist.mjs",
    "build:debug": "cross-env DEBUG=true npm run build",
    "test": "jest",
    "test:coverage": "jest --collectCoverage=true"
  }
}
